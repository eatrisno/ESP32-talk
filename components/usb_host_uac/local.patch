+bool uac_host_device_feedback(uac_host_device_handle_t uac_dev_handle, uint32_t *rate_mhz, uint32_t *accepted)
+{
+    uac_iface_t *iface = get_iface_by_handle(uac_dev_handle);
+    if (!iface || !iface->fb_active) {
+        return false;
+    }
+    if (rate_mhz) {
+        *rate_mhz = (uint32_t)(((uint64_t)iface->fb.rate_q16 * 1000000u) >> 16);  // samples per second x 1000
+    }
+    if (accepted) {
+        *accepted = iface->fb.accepted;
+    }
+    return true;
 }
 
