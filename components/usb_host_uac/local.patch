+static void stream_fb_xfer_done(usb_transfer_t *fb_xfer)
+{
+    uac_iface_t *iface = fb_xfer->context;
+    assert(iface);
+    if (iface->state != UAC_INTERFACE_STATE_ACTIVE) {
+        return;  // stopping: do not resubmit
+    }
+    if (fb_xfer->status == USB_TRANSFER_STATUS_COMPLETED && fb_xfer->isoc_packet_desc[0].status == USB_TRANSFER_STATUS_COMPLETED) {
+        xSemaphoreTake(iface->ringbuf_mutex, portMAX_DELAY);  // packet sizing reads fb under this lock
+        uac_fb_update(&iface->fb, fb_xfer->data_buffer, fb_xfer->isoc_packet_desc[0].actual_num_bytes, iface->fb_high_speed);
+        xSemaphoreGive(iface->ringbuf_mutex);
+    }
+    if (fb_xfer->status == USB_TRANSFER_STATUS_NO_DEVICE || fb_xfer->status == USB_TRANSFER_STATUS_CANCELED) {
+        return;
+    }
+    // Any other status (an isochronous IN packet can be missed): poll again; the last good
+    // rate stays in use meanwhile.
+    usb_host_transfer_submit(fb_xfer);
+}
